# ============================================================================
# Yiwu Yiling Accessories — Environment template
# Copy this file to `.env.local` for local dev, or set the same keys in Vercel.
# ============================================================================

# --- Public Supabase (safe for browser) ---
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Service role (server-side admin actions; bypasses RLS) ---
# NEVER commit this or expose it to the browser.
# Set it ONLY in Vercel Environment Variables (production + preview).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Optional: site URL used for redirects (logout etc.) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
